{
  "bunVersion": "1.x",
  "buildCommand": "bun install && cd web && bun install && bun run build",
  "outputDirectory": "web/dist",
  "framework": null,
    "rewrites": [
        {
        "source": "/api/(.*)",
        "destination": "/api/index"
        },
        {
        "source": "/((?!api/).*)",
        "destination": "/web/$1"
        }
    ]
}